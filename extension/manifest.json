{
  "manifest_version": 3,
  "name": "Bookmark Bar Centerer",
  "version": "1.2.1",
  "description": "Центрирует панель закладок с помощью невидимых закладок-разделителей.",
  "permissions": ["bookmarks", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Bar Centerer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/blank16.png",
    "32": "icons/blank32.png",
    "48": "icons/blank48.png",
    "128": "icons/icon128.png"
  }
}
